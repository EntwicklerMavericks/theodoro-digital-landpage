---
import { config } from '../data/config';
import { translations } from '../data/translations';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { 
  title = config.seo.title, 
  description = config.seo.description 
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		
		<!-- Primary Meta Tags & SEO -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow" />
		<meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
		<link rel="canonical" href={config.seo.canonical} />
		
		<!-- Favicons & Icons -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
		<link rel="alternate icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2" />
		<link rel="alternate icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=2" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />
		<link rel="shortcut icon" href="/favicon.ico?v=2" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
		<meta name="theme-color" content="#020202" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Open Graph / Facebook / WhatsApp / LinkedIn -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={config.seo.canonical} />
		<meta property="og:site_name" content={config.brandName} />
		<meta property="og:locale" content="pt_BR" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={config.seo.ogImage} />
		<meta property="og:image:secure_url" content={config.seo.ogImage} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Theodoro Digital - Desenvolvimento Web e Soluções Digitais" />
		
		<!-- Twitter Cards -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={config.seo.canonical} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={config.seo.ogImage} />
		<meta name="twitter:image:alt" content="Theodoro Digital - Desenvolvimento Web e Soluções Digitais" />

		<!-- Schema.org JSON-LD Structured Data -->
		<script type="application/ld+json" is:inline set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "ProfessionalService",
			"name": "Theodoro Digital",
			"url": "https://theodorodigital.com/",
			"logo": "https://theodorodigital.com/theodoro-logo.png",
			"image": "https://theodorodigital.com/banner-og.png",
			"description": description,
			"telephone": "+55-11-96174-2713",
			"sameAs": [
				"https://www.linkedin.com/in/eduardot97",
				"https://github.com/EntwicklerMavericks"
			]
		})} />
		
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@300;400;600;800&family=Space+Grotesk:wght@400;600;700&display=swap" rel="stylesheet">
	</head>
	<body>
		<slot />
		
		<!-- Core Scroll Reveal -->
		<script is:inline>
		  document.addEventListener('DOMContentLoaded', () => {
		    const observerOptions = {
		      root: null,
		      rootMargin: '250px 0px 0px 0px',
		      threshold: 0
		    };
		    
		    const observer = new IntersectionObserver((entries, obs) => {
		      entries.forEach(entry => {
		        if (entry.isIntersecting) {
		          entry.target.classList.add('active');
		          obs.unobserve(entry.target);
		        }
		      });
		    }, observerOptions);
		    
		    const sections = document.querySelectorAll('main > section:not(:first-child)');
		    sections.forEach(section => {
		      section.classList.add('reveal');
		      observer.observe(section);
		    });
		  });
		</script>

		<!-- Multi-Language (i18n) Engine -->
		<script is:inline define:vars={{ translationsData: translations }}>
		  window.__TRANSLATIONS = translationsData;
		  
		  function getNested(obj, path) {
		    return path.split('.').reduce((acc, part) => (acc ? acc[part] : undefined), obj);
		  }
		  
		  window.__setLanguage = function(lang) {
		    if (!window.__TRANSLATIONS || !window.__TRANSLATIONS[lang]) return;
		    
		    try {
		      localStorage.setItem('theodoro_lang', lang);
		    } catch(e) {}
		    
		    document.documentElement.lang = lang === 'pt' ? 'pt-BR' : lang;
		    
		    // Update language switcher active states
		    document.querySelectorAll('.lang-btn').forEach(btn => {
		      btn.classList.toggle('active', btn.getAttribute('data-lang') === lang);
		    });
		    
		    const t = window.__TRANSLATIONS[lang];
		    
		    // Translate inner text and HTML
		    document.querySelectorAll('[data-i18n]').forEach(el => {
		      const key = el.getAttribute('data-i18n');
		      const val = getNested(t, key);
		      if (val !== undefined && typeof val === 'string') {
		        if (val.includes('<') || el.hasAttribute('data-i18n-html')) {
		          el.innerHTML = val;
		        } else {
		          el.textContent = val;
		        }
		      }
		    });
		    
		    // Translate placeholder attributes
		    document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
		      const key = el.getAttribute('data-i18n-placeholder');
		      const val = getNested(t, key);
		      if (val !== undefined && typeof val === 'string') {
		        el.setAttribute('placeholder', val);
		      }
		    });
		    
		    // Broadcast language change to dynamic components
		    window.dispatchEvent(new CustomEvent('languageChange', { detail: { lang, t } }));
		  };

		  document.addEventListener('DOMContentLoaded', () => {
		    let initialLang = 'pt';
		    try {
		      const stored = localStorage.getItem('theodoro_lang');
		      if (stored && (stored === 'pt' || stored === 'en' || stored === 'es')) {
		        initialLang = stored;
		      }
		    } catch(e) {}
		    
		    window.__setLanguage(initialLang);
		    
		    // Bind switcher buttons
		    document.querySelectorAll('.lang-btn').forEach(btn => {
		      btn.addEventListener('click', () => {
		        const lang = btn.getAttribute('data-lang');
		        if (lang) window.__setLanguage(lang);
		      });
		    });
		  });
		</script>
	</body>
</html>
