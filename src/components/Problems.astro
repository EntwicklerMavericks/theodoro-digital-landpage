---
const problems = [
  {
    question: "Sua empresa precisa atrair mais clientes pela internet?",
    solution: "Crio landing pages e sites focados em conversão e captação de leads."
  },
  {
    question: "Você ainda depende de planilhas para organizar a operação?",
    solution: "Desenvolvo sistemas de gestão sob medida, centralizando suas informações."
  },
  {
    question: "Sua equipe perde tempo com tarefas manuais?",
    solution: "Automatizo fluxos repetitivos, integrando os sistemas que você já usa."
  },
  {
    question: "Seus clientes precisam entrar em contato para obter informações básicas?",
    solution: "Crio portais e catálogos digitais acessíveis 24/7 para seus clientes."
  },
  {
    question: "Você precisa integrar sistemas que não se comunicam?",
    solution: "Construo APIs e conecto diferentes plataformas de forma segura."
  },
  {
    question: "Tem uma ideia de aplicativo ou plataforma e precisa desenvolvê-la?",
    solution: "Transformo sua ideia em um MVP real, robusto e escalável."
  }
];
---

<section id="problemas" class="problems reveal">
  <canvas id="radar-canvas" class="radar-bg"></canvas>
  <div class="radar-overlay"></div>
  
  <div class="container relative">
    <div class="section-header text-center">
      <div class="badge-alert">SCANNER DE MERCADO</div>
      <h2>O seu crescimento está sendo <span class="text-gradient">sabotado?</span></h2>
      <p>Empresas travam quando a tecnologia não acompanha a operação. Você se identifica com algum desses cenários?</p>
    </div>
    
    <div class="problems-grid">
      {problems.map((p, index) => (
        <div class="problem-card" style={`--delay: ${index * 0.1}s`}>
          <div class="card-glitch-layer"></div>
          <div class="icon-wrapper">
            <div class="icon-pulse"></div>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
          </div>
          <div class="problem-content">
            <h3>{p.question}</h3>
            <p>{p.solution}</p>
          </div>
        </div>
      ))}
    </div>
    
    <div class="premium-cta-banner">
      <div class="banner-glow"></div>
      <div class="banner-content">
        <h3>Pronto para otimizar sua operação?</h3>
        <p>Cada negócio tem suas particularidades. Vamos entender o seu cenário e arquitetar a solução ideal para os seus desafios.</p>
        <a href="#orcamento" class="btn-primary pulse-btn">
          <span>Quero conversar sobre meu negócio</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .problems {
    background-color: #020203;
    position: relative;
    padding: 8rem 0;
    overflow: hidden;
  }
  
  .radar-bg {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    z-index: 0;
    pointer-events: none;
    opacity: 0.8;
  }
  
  .radar-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, transparent 0%, #020203 90%);
    z-index: 1;
    pointer-events: none;
  }
  
  .relative { position: relative; z-index: 2; }
  
  .badge-alert {
    display: inline-block;
    padding: 0.4rem 1rem;
    background: rgba(168, 85, 247, 0.1);
    color: #c084fc;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(168, 85, 247, 0.3);
    box-shadow: 0 0 15px rgba(168, 85, 247, 0.2);
  }
  
  .section-header {
    margin-bottom: 5rem;
    text-align: center;
  }
  
  .section-header h2 {
    font-size: 3rem;
  }
  
  .section-header p {
    color: #94a3b8;
    font-size: 1.15rem;
    margin-top: 1rem;
  }
  
  .problems-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  
  .problem-card {
    background-color: rgba(10, 10, 15, 0.7);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 2rem;
    display: flex;
    gap: 1.5rem;
    position: relative;
    overflow: hidden;
    transition: all 0.4s ease;
  }
  
  .problem-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 2px; height: 100%;
    background: rgba(255, 255, 255, 0.1);
    transition: 0.4s ease;
  }
  
  .problem-card:hover {
    transform: translateY(-5px);
    border-color: rgba(168, 85, 247, 0.3);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), inset 0 0 20px rgba(168, 85, 247, 0.05);
  }
  
  .problem-card:hover::before {
    background: #a855f7;
    box-shadow: 0 0 10px #a855f7;
  }
  
  .card-glitch-layer {
    position: absolute;
    inset: 0;
    background: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    opacity: 0;
    mix-blend-mode: overlay;
    transition: 0.3s;
    pointer-events: none;
  }
  
  .problem-card:hover .card-glitch-layer {
    opacity: 0.15;
  }
  
  .icon-wrapper {
    position: relative;
    color: #a855f7;
    flex-shrink: 0;
    width: 24px;
    height: 24px;
  }
  
  .icon-pulse {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 100%; height: 100%;
    border-radius: 50%;
    background: rgba(168, 85, 247, 0.2);
    animation: alert-pulse 2s infinite;
  }
  
  @keyframes alert-pulse {
    0% { transform: translate(-50%, -50%) scale(1); opacity: 0.8; }
    100% { transform: translate(-50%, -50%) scale(2.5); opacity: 0; }
  }
  
  .problem-content h3 {
    font-size: 1.15rem;
    margin-bottom: 0.75rem;
    color: #f8fafc;
  }
  
  .problem-content p {
    color: #94a3b8;
    font-size: 0.95rem;
    line-height: 1.6;
  }
  
  .premium-cta-banner {
    position: relative;
    margin-top: 5rem;
    border-radius: 24px;
    padding: 1px;
    background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.01) 100%);
    overflow: hidden;
    box-shadow: 0 30px 60px rgba(0,0,0,0.6);
  }
  
  .banner-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 150%;
    height: 150%;
    background: radial-gradient(ellipse at center, rgba(168, 85, 247, 0.15) 0%, transparent 60%);
    z-index: 0;
    pointer-events: none;
    animation: slow-pulse 8s ease-in-out infinite alternate;
  }
  
  @keyframes slow-pulse {
    0% { opacity: 0.5; transform: translate(-50%, -50%) scale(1); }
    100% { opacity: 1; transform: translate(-50%, -50%) scale(1.1); }
  }
  
  .banner-content {
    position: relative;
    z-index: 1;
    background: #0a0a0c;
    border-radius: 23px;
    padding: 5rem 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(10px);
  }
  
  .banner-content h3 {
    font-size: 2.2rem;
    margin-bottom: 1rem;
    background: linear-gradient(to right, #ffffff, #c084fc);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: -0.02em;
  }
  
  .banner-content p {
    font-size: 1.1rem;
    color: #94a3b8;
    max-width: 600px;
    margin-bottom: 2.5rem;
    line-height: 1.6;
  }
  
  .pulse-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    position: relative;
    overflow: hidden;
  }
  
  .pulse-btn::after {
    content: '';
    position: absolute;
    top: 0; left: -100%; width: 100%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.25), transparent);
    transition: left 0.7s ease;
  }
  
  .pulse-btn:hover::after { left: 100%; }
  .pulse-btn svg { transition: transform 0.3s ease; }
  .pulse-btn:hover svg { transform: translateX(6px); }

  @media (max-width: 768px) {
    .banner-content { padding: 3rem 1.5rem; }
    .banner-content h3 { font-size: 1.8rem; }
  }
</style>

<script>
  const canvas = document.getElementById('radar-canvas') as HTMLCanvasElement;
  if (canvas) {
    const ctx = canvas.getContext('2d');
    let width = 0;
    let height = 0;
    let centerX = 0;
    let centerY = 0;
    let maxRadius = 0;
    
    // Configurable dots (stores / targets)
    const targets: {x: number, y: number, distance: number, alpha: number}[] = [];
    const numTargets = 20;
    
    const waves: {radius: number}[] = [{radius: 0}];
    let frame = 0;
    
    function resize() {
      width = canvas.parentElement?.clientWidth || window.innerWidth;
      height = canvas.parentElement?.clientHeight || window.innerHeight;
      canvas.width = width;
      canvas.height = height;
      centerX = width / 2;
      centerY = height / 2;
      maxRadius = Math.max(width, height);
      
      // Generate random targets
      targets.length = 0;
      for (let i = 0; i < numTargets; i++) {
        // Random point in circle
        const r = Math.random() * (maxRadius * 0.9);
        const theta = Math.random() * Math.PI * 2;
        const tx = centerX + r * Math.cos(theta);
        const ty = centerY + r * Math.sin(theta);
        
        targets.push({
          x: tx,
          y: ty,
          distance: r,
          alpha: 0
        });
      }
    }
    
    window.addEventListener('resize', resize);
    resize();
    
    function draw() {
      if (!ctx) return;
      frame++;
      
      // Clear background perfectly (no trail needed for waves)
      ctx.fillStyle = '#020203';
      ctx.fillRect(0, 0, width, height);
      
      // Spawn new wave every 120 frames (approx 2s)
      if (frame % 120 === 0) {
        waves.push({radius: 0});
      }
      
      // Process and draw waves
      for (let i = waves.length - 1; i >= 0; i--) {
        const wave = waves[i];
        wave.radius += 3.5; // Wave speed
        
        if (wave.radius > maxRadius) {
          waves.splice(i, 1);
          continue;
        }
        
        // Calculate opacity based on size
        const alpha = Math.max(0, 1 - (wave.radius / maxRadius));
        
        // Draw the expanding wave
        ctx.beginPath();
        ctx.arc(centerX, centerY, wave.radius, 0, Math.PI * 2);
        
        // Inner gradient for the wave thickness
        ctx.lineWidth = 4;
        ctx.strokeStyle = `rgba(168, 85, 247, ${alpha * 0.6})`;
        ctx.stroke();
        
        // Ghost trailing wave
        ctx.beginPath();
        ctx.arc(centerX, centerY, Math.max(0, wave.radius - 15), 0, Math.PI * 2);
        ctx.lineWidth = 10;
        ctx.strokeStyle = `rgba(168, 85, 247, ${alpha * 0.15})`;
        ctx.stroke();
        
        // Check intersections with targets
        targets.forEach(t => {
          if (Math.abs(wave.radius - t.distance) < 4) {
            t.alpha = 1; // Ping the target!
          }
        });
      }
      
      // Draw targets
      targets.forEach(t => {
        // Always draw a very faint dot so the map doesn't look empty
        ctx.beginPath();
        ctx.arc(t.x, t.y, 2, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(168, 85, 247, 0.15)`;
        ctx.fill();
        
        // Draw the active ping
        if (t.alpha > 0) {
          ctx.save();
          // Glowing core
          ctx.beginPath();
          ctx.arc(t.x, t.y, 6, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(255, 255, 255, ${t.alpha})`;
          ctx.shadowBlur = 15;
          ctx.shadowColor = '#a855f7';
          ctx.fill();
          
          // Outer neon expanding ring
          ctx.beginPath();
          const ringSize = 6 + (1 - t.alpha) * 25;
          ctx.arc(t.x, t.y, ringSize, 0, Math.PI * 2);
          ctx.strokeStyle = `rgba(168, 85, 247, ${t.alpha})`;
          ctx.lineWidth = 2;
          ctx.stroke();
          
          ctx.restore();
          
          t.alpha -= 0.015; // Fade out speed
        }
      });
      
      requestAnimationFrame(draw);
    }
    
    draw();
  }
</script>
