---
---
<section class="hero-complex">
  <canvas id="tech-canvas"></canvas>
  
  <div class="hero-overlay"></div>
  
  <div class="container hero-content">
    <div class="hero-text-center">
      <div class="tech-badge">
        <span class="live-dot"></span> <span data-i18n="hero.badge">DESENVOLVIMENTO • DESIGN • TECNOLOGIA</span>
      </div>
      
      <h1 class="glitch-headline" data-i18n="hero.headline" data-i18n-html>
        <span class="sr-only">Theodoro Digital — Desenvolvimento Web e </span>Tecnologia sob medida para <br/>
        <span class="gradient-text animated-gradient">impulsionar seu negócio.</span>
      </h1>
      
      <p class="hero-description" data-i18n="hero.description" data-i18n-html>
        Crio sites, landing pages e sistemas personalizados para transformar suas ideias em soluções digitais eficientes, profissionais e preparadas para crescer com sua empresa.
      </p>
      
      <div class="hero-actions">
        <a href="#orcamento" class="btn-cyber">
          <span class="btn-text" data-i18n="hero.cta">Iniciar Projeto</span>
        </a>
      </div>
    </div>
  </div>
  
  <div class="scroll-indicator">
    <div class="mouse">
      <div class="wheel"></div>
    </div>
    <p data-i18n="hero.explore">Explore</p>
  </div>
</section>

<style>
  .hero-complex {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-top: calc(85px + clamp(2rem, 5vh, 4rem));
    padding-bottom: clamp(3rem, 7vh, 5rem);
    overflow: hidden;
    background-color: #020202;
  }
  
  #tech-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }
  
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, transparent 0%, #020202 85%);
    z-index: 2;
    pointer-events: none;
  }
  
  .hero-content {
    position: relative;
    z-index: 10;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 1000px;
    width: 100%;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  
  .hero-text-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .tech-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 18px;
    background: rgba(20, 20, 25, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 50px;
    backdrop-filter: blur(12px);
    font-size: clamp(0.7rem, 0.9vw, 0.8rem);
    font-weight: 600;
    letter-spacing: 0.18em;
    color: #fff;
    margin-bottom: clamp(1.2rem, 2.5vh, 2rem);
    box-shadow: 0 0 20px rgba(168, 85, 247, 0.2);
  }
  
  .live-dot {
    width: 8px;
    height: 8px;
    background-color: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 10px #10b981;
    animation: blink 2s infinite;
    flex-shrink: 0;
  }
  
  @keyframes blink {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.8); }
  }
  
  .glitch-headline {
    font-size: clamp(2.3rem, 4.4vw, 4rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.035em;
    color: #ffffff;
    margin-bottom: clamp(1.2rem, 2.2vh, 1.8rem);
    text-shadow: 0 10px 30px rgba(0,0,0,0.6);
    max-width: 900px;
  }
  
  .animated-gradient {
    background: linear-gradient(to right, #a855f7, #3b82f6, #a855f7);
    background-size: 200% auto;
    color: #fff;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shine 4s linear infinite;
  }
  
  @keyframes shine {
    to { background-position: 200% center; }
  }
  
  .hero-description {
    font-size: clamp(1rem, 1.25vw, 1.2rem);
    color: #94a3b8;
    max-width: 680px;
    margin: 0 auto clamp(1.8rem, 3.5vh, 2.8rem);
    line-height: 1.65;
    text-shadow: 0 2px 10px rgba(0,0,0,0.8);
  }
  
  .hero-description strong {
    color: #fff;
  }
  
  .hero-actions {
    display: flex;
    justify-content: center;
    width: 100%;
    position: relative;
    z-index: 12;
  }

  /* Cyber Button (Original Style) */
  .btn-cyber {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 18px 42px;
    background: transparent;
    color: #ffffff;
    font-size: clamp(0.85rem, 1vw, 0.95rem);
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    z-index: 1;
    max-width: min(100%, 460px);
    text-align: center;
  }
  
  .btn-cyber::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(168, 85, 247, 0.12);
    border: 1px solid rgba(168, 85, 247, 0.7);
    box-shadow: inset 0 0 20px rgba(168, 85, 247, 0.25), 0 0 25px rgba(168, 85, 247, 0.35);
    z-index: -1;
    transform: skewX(-15deg);
    transition: all 0.3s ease;
  }
  
  .btn-cyber:hover::before {
    background: rgba(168, 85, 247, 0.28);
    box-shadow: inset 0 0 30px rgba(168, 85, 247, 0.5), 0 0 35px rgba(168, 85, 247, 0.6);
    border-color: #c084fc;
    transform: skewX(-15deg) scale(1.02);
  }

  .btn-cyber:active::before {
    transform: skewX(-15deg) scale(0.98);
  }
  
  .scroll-indicator {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    z-index: 10;
    opacity: 0.6;
    animation: fade-bounce 2s infinite;
    pointer-events: none;
  }
  
  .scroll-indicator p {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #fff;
  }
  
  .mouse {
    width: 24px;
    height: 38px;
    border: 2px solid #fff;
    border-radius: 20px;
    display: flex;
    justify-content: center;
    padding-top: 5px;
  }
  
  .wheel {
    width: 3px;
    height: 7px;
    background: #fff;
    border-radius: 2px;
    animation: scroll 1.5s infinite;
  }
  
  @keyframes scroll {
    0% { transform: translateY(0); opacity: 1; }
    100% { transform: translateY(14px); opacity: 0; }
  }
  
  @keyframes fade-bounce {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, -8px); }
  }

  /* Hide scroll indicator whenever viewport height is tight or mobile to avoid collision with CTA button */
  @media (max-height: 820px), (max-width: 900px) {
    .scroll-indicator {
      display: none !important;
    }
  }

  /* Compact height viewports (laptops, rotated tablets, small desktop windows) */
  @media (max-height: 740px) {
    .hero-complex {
      padding-top: 95px;
      padding-bottom: 30px;
    }
    
    .tech-badge {
      font-size: 0.7rem;
      padding: 5px 12px;
      margin-bottom: 0.9rem;
    }
    
    .glitch-headline {
      font-size: clamp(1.8rem, 3.2vw, 2.7rem);
      margin-bottom: 0.9rem;
    }
    
    .hero-description {
      font-size: 0.92rem;
      line-height: 1.5;
      margin-bottom: 1.5rem;
    }
    
    .btn-cyber {
      padding: 14px 32px;
      font-size: 0.85rem;
    }
  }

  @media (max-width: 768px) {
    .hero-complex {
      min-height: 100vh;
      min-height: 100dvh;
      padding: 120px 1rem 50px;
    }
    
    .tech-badge {
      font-size: 0.65rem;
      letter-spacing: 0.12em;
      padding: 6px 14px;
      margin-bottom: 1.2rem;
    }
    
    .glitch-headline {
      font-size: clamp(1.85rem, 8vw, 2.4rem);
      line-height: 1.18;
      margin-bottom: 1.1rem;
    }
    
    .hero-description {
      font-size: 0.95rem;
      line-height: 1.6;
      padding: 0;
      margin-bottom: 2rem;
    }
    
    .btn-cyber {
      padding: 16px 30px;
      font-size: 0.85rem;
      letter-spacing: 1px;
      width: auto;
      max-width: calc(100vw - 32px);
    }
  }
</style>

<script>
  // High-performance Canvas Particle Network
  const canvas = document.getElementById('tech-canvas') as HTMLCanvasElement;
  
  if (canvas) {
    const ctx = canvas.getContext('2d');
    
    let particlesArray: Particle[] = [];
    let mouse = { x: -1000, y: -1000, radius: 150 };
    
    window.addEventListener('mousemove', (e) => {
      mouse.x = e.x;
      mouse.y = e.y;
    });
    
    window.addEventListener('mouseout', () => {
      mouse.x = -1000;
      mouse.y = -1000;
    });
    
    class Particle {
      x: number;
      y: number;
      dirX: number;
      dirY: number;
      size: number;
      baseX: number;
      baseY: number;
      density: number;
      
      constructor(x: number, y: number, dirX: number, dirY: number, size: number) {
        this.x = x;
        this.y = y;
        this.dirX = dirX;
        this.dirY = dirY;
        this.size = size;
        this.baseX = this.x;
        this.baseY = this.y;
        this.density = (Math.random() * 30) + 1;
      }
      
      draw() {
        if(!ctx) return;
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(168, 85, 247, 0.8)';
        ctx.fill();
      }
      
      update() {
        if(!ctx) return;
        
        // Bounce edges
        if (this.x > canvas.width || this.x < 0) this.dirX = -this.dirX;
        if (this.y > canvas.height || this.y < 0) this.dirY = -this.dirY;
        
        // Mouse interaction (repel)
        let dx = mouse.x - this.x;
        let dy = mouse.y - this.y;
        let distance = Math.sqrt(dx*dx + dy*dy);
        
        if (distance < mouse.radius) {
          const forceDirX = dx / distance;
          const forceDirY = dy / distance;
          const force = (mouse.radius - distance) / mouse.radius;
          const dirX = forceDirX * force * this.density;
          const dirY = forceDirY * force * this.density;
          
          this.x -= dirX;
          this.y -= dirY;
        } else {
          // Return to base position slowly
          if (this.x !== this.baseX) {
            let dx = this.x - this.baseX;
            this.x -= dx/20;
          }
          if (this.y !== this.baseY) {
            let dy = this.y - this.baseY;
            this.y -= dy/20;
          }
        }
        
        this.x += this.dirX;
        this.y += this.dirY;
        
        this.draw();
      }
    }
    
    function init() {
      particlesArray = [];
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
      
      const numParticles = (canvas.width * canvas.height) / 12000;
      
      for (let i = 0; i < numParticles; i++) {
        let size = (Math.random() * 2) + 0.5;
        let x = (Math.random() * ((innerWidth - size * 2) - (size * 2)) + size * 2);
        let y = (Math.random() * ((innerHeight - size * 2) - (size * 2)) + size * 2);
        let dirX = (Math.random() * 1) - 0.5;
        let dirY = (Math.random() * 1) - 0.5;
        
        particlesArray.push(new Particle(x, y, dirX, dirY, size));
      }
    }
    
    function connect() {
      if(!ctx) return;
      let opacity = 1;
      for (let a = 0; a < particlesArray.length; a++) {
        for (let b = a; b < particlesArray.length; b++) {
          let dx = particlesArray[a].x - particlesArray[b].x;
          let dy = particlesArray[a].y - particlesArray[b].y;
          let distance = (dx * dx) + (dy * dy);
          
          if (distance < (canvas.width/10) * (canvas.height/10)) {
            opacity = 1 - (distance / 20000);
            ctx.strokeStyle = `rgba(168, 85, 247, ${opacity * 0.5})`;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(particlesArray[a].x, particlesArray[a].y);
            ctx.lineTo(particlesArray[b].x, particlesArray[b].y);
            ctx.stroke();
          }
        }
      }
    }
    
    function animate() {
      if(!ctx) return;
      requestAnimationFrame(animate);
      ctx.clearRect(0, 0, innerWidth, innerHeight);
      
      for (let i = 0; i < particlesArray.length; i++) {
        particlesArray[i].update();
      }
      connect();
    }
    
    window.addEventListener('resize', init);
    
    init();
    animate();
  }
</script>
