---
const steps = [
  {
    id: "01",
    title: "Discovery & Arquitetura",
    desc: "Mapeamento profundo do seu modelo de negócio. Desenhamos o escopo técnico, escolhemos a stack ideal e estruturamos o banco de dados antes de escrever qualquer linha de código."
  },
  {
    id: "02",
    title: "Prototipagem & UX Premium",
    desc: "Criação de interfaces de alta fidelidade focadas em retenção de usuários e conversão. Você visualiza e aprova toda a experiência antes do desenvolvimento iniciar."
  },
  {
    id: "03",
    title: "Desenvolvimento Ágil",
    desc: "Engenharia robusta em ciclos curtos. Código limpo, testes automatizados e integração contínua para garantir que a aplicação seja construída de forma segura e escalável."
  },
  {
    id: "04",
    title: "Deploy & Escala",
    desc: "Implantação em infraestrutura cloud de alta disponibilidade. Monitoramento em tempo real de gargalos e suporte focado na evolução constante do ecossistema."
  }
];
---

<section id="metodologia" class="process-section reveal">
  <div class="container">
    <div class="section-header text-center">
      <div class="badge">COMO OPERAMOS</div>
      <h2>Metodologia de <span class="text-gradient animated-gradient">Alta Precisão</span></h2>
      <p>Um fluxo de trabalho projetado para mitigar riscos e entregar software nível enterprise, respeitando prazos e objetivos de negócio.</p>
    </div>
    
    <div class="timeline-container">
      <div class="timeline-track">
        <div class="timeline-glow" id="timeline-glow"></div>
      </div>
      
      <div class="timeline-steps">
        {steps.map((step, index) => (
          <div class="timeline-step">
            <div class="step-node">
              <div class="node-core"></div>
              <div class="node-pulse"></div>
            </div>
            
            <div class="step-card">
              <div class="step-number">{step.id}</div>
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .process-section {
    padding: 10rem 0;
    background-color: #020202;
    position: relative;
    overflow: hidden;
  }
  
  .process-section::before {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background-image: linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 100px 100px;
    z-index: 0;
  }
  
  .container {
    position: relative;
    z-index: 1;
  }
  
  .badge {
    display: inline-block;
    padding: 0.4rem 1rem;
    background: rgba(59, 130, 246, 0.1);
    color: #60a5fa;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(59, 130, 246, 0.2);
  }
  
  .section-header {
    margin-bottom: 6rem;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }
  
  .section-header h2 {
    font-size: 3rem;
  }
  
  .section-header p {
    color: #94a3b8;
    font-size: 1.15rem;
    margin-top: 1.5rem;
  }
  
  .animated-gradient {
    background: linear-gradient(to right, #3b82f6, #a855f7, #3b82f6);
    background-size: 200% auto;
    color: #fff;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shine 4s linear infinite;
  }
  
  /* Timeline Core */
  .timeline-container {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 0;
  }
  
  .timeline-track {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    background: rgba(255, 255, 255, 0.05);
    transform: translateX(-50%);
    border-radius: 2px;
  }
  
  .timeline-glow {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 0%;
    background: linear-gradient(180deg, transparent, #a855f7, #3b82f6);
    box-shadow: 0 0 15px #a855f7, 0 0 30px #3b82f6;
    transition: height 0.1s ease;
    border-radius: 2px;
  }
  
  .timeline-steps {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }
  
  .timeline-step {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }
  
  .timeline-step:nth-child(odd) {
    flex-direction: row-reverse;
  }
  
  .step-node {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #020202;
    border: 2px solid rgba(255, 255, 255, 0.1);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: 0.3s ease;
  }
  
  .timeline-step.active .step-node {
    border-color: #a855f7;
    box-shadow: 0 0 20px rgba(168, 85, 247, 0.5);
  }
  
  .node-core {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    transition: 0.3s ease;
  }
  
  .timeline-step.active .node-core {
    background: #fff;
  }
  
  .node-pulse {
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    border: 1px solid #a855f7;
    opacity: 0;
    transform: scale(0.5);
  }
  
  .timeline-step.active .node-pulse {
    animation: pulse-ring 2s infinite cubic-bezier(0.215, 0.61, 0.355, 1);
  }
  
  @keyframes pulse-ring {
    0% { transform: scale(0.5); opacity: 0; }
    50% { opacity: 0.5; }
    100% { transform: scale(1.5); opacity: 0; }
  }
  
  .step-card {
    width: calc(50% - 40px);
    background: rgba(10, 10, 15, 0.8);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 16px;
    padding: 2.5rem;
    position: relative;
    transition: transform 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease;
  }
  
  .step-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 16px;
    background: radial-gradient(800px circle at var(--mouse-x, 0) var(--mouse-y, 0), rgba(168, 85, 247, 0.06), transparent 40%);
    z-index: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s;
  }
  
  .step-card:hover::before {
    opacity: 1;
  }
  
  .timeline-step.active .step-card {
    border-color: rgba(168, 85, 247, 0.3);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), inset 0 0 20px rgba(168, 85, 247, 0.05);
    transform: translateY(-5px);
  }
  
  .step-card > * {
    position: relative;
    z-index: 1;
  }
  
  .step-number {
    font-size: 4rem;
    font-weight: 800;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.1);
    position: absolute;
    top: 10px;
    right: 20px;
    line-height: 1;
    pointer-events: none;
    transition: 0.4s ease;
  }
  
  .timeline-step.active .step-number {
    -webkit-text-stroke: 1px rgba(168, 85, 247, 0.3);
  }
  
  .step-card h3 {
    font-size: 1.4rem;
    margin-bottom: 1rem;
    color: #f8fafc;
  }
  
  .step-card p {
    color: #94a3b8;
    font-size: 1rem;
    line-height: 1.6;
  }
  
  @media (max-width: 768px) {
    .timeline-track {
      left: 20px;
      transform: none;
    }
    
    .timeline-step, .timeline-step:nth-child(odd) {
      flex-direction: column;
      align-items: flex-end;
    }
    
    .step-node {
      left: 20px;
      transform: translate(-50%, -50%);
    }
    
    .step-card {
      width: calc(100% - 50px);
      padding: 2rem;
    }
  }
</style>

<script>
  // Advanced Scroll Timeline Logic
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.getElementById('timeline-glow');
    const steps = document.querySelectorAll('.timeline-step');
    const container = document.querySelector('.timeline-container');
    
    if (track && container && steps.length > 0) {
      const handleScroll = () => {
        const containerRect = container.getBoundingClientRect();
        const viewportHeight = window.innerHeight;
        
        // Calculate how much of the container has been scrolled past the middle of the screen
        const startOffset = containerRect.top - (viewportHeight / 2);
        const endOffset = containerRect.bottom - (viewportHeight / 2);
        const totalHeight = containerRect.height;
        
        let progress = 0;
        
        if (startOffset < 0) {
          progress = Math.min(100, Math.max(0, (Math.abs(startOffset) / totalHeight) * 100));
        }
        
        // Add a little extra so the line goes past the last dot
        track.style.height = `${progress + 5}%`;
        
        // Activate steps based on line position
        steps.forEach((step, index) => {
          const stepRect = step.getBoundingClientRect();
          const stepCenter = stepRect.top + (stepRect.height / 2);
          
          if (stepCenter < (viewportHeight / 2) + 50) {
            step.classList.add('active');
          } else {
            step.classList.remove('active');
          }
        });
      };
      
      window.addEventListener('scroll', handleScroll, { passive: true });
      handleScroll(); // Init
      
      // Card hover effect tracking
      steps.forEach(step => {
        const card = step.querySelector('.step-card') as HTMLElement;
        if (card) {
          card.addEventListener('mousemove', (e) => {
            const rect = card.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            card.style.setProperty('--mouse-x', `${x}px`);
            card.style.setProperty('--mouse-y', `${y}px`);
          });
        }
      });
    }
  });
</script>
