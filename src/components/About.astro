---
---

<section id="sobre" class="about reveal">
  <div class="container">
    <div class="about-grid">
      <div class="about-content">
        <div class="badge" data-i18n="about.badge">A ENGENHARIA</div>
        <h2 data-i18n="about.title" data-i18n-html>Sistemas construídos para <span class="text-gradient animated-gradient">performance e escala.</span></h2>
        
        <div class="about-text">
          <p data-i18n="about.p1" data-i18n-html>O mercado está saturado de soluções lentas e agências que dependem de templates genéricos. Atuamos como o <strong>braço de engenharia tecnológica</strong> do seu negócio.</p>
          <p data-i18n="about.p2">Seja para modernizar uma operação travada, lançar um produto digital imbatível ou automatizar processos internos, aplicamos os mesmos padrões de segurança e arquitetura utilizados por grandes players de tecnologia.</p>
        </div>
        
        <div class="tech-stack">
          <div class="stack-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span data-i18n="about.stack1">Arquitetura Resiliente</span>
          </div>
          <div class="stack-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span data-i18n="about.stack2">UI/UX Premium</span>
          </div>
          <div class="stack-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span data-i18n="about.stack3">Código Escalável</span>
          </div>
          <div class="stack-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span data-i18n="about.stack4">Deploy Contínuo</span>
          </div>
        </div>
      </div>
      
      <div class="about-visual">
        <div class="cyber-window" id="terminal-window">
          <div class="window-header">
            <div class="dots">
              <span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span>
            </div>
            <div class="terminal-title" id="terminal-title-text" data-i18n="about.terminalHeader">visitante@theodoro-digital: ~</div>
          </div>
          <div class="window-body" id="interactive-terminal" tabindex="0">
            <div id="terminal-output">
              <div class="line output success" id="term-line-init" data-i18n="about.terminalInit">TheodoroOS v2.0.4 - Sistema Inicializado</div>
              <div class="line output" id="term-line-help" data-i18n="about.terminalHelpPrompt">Digite 'ajuda' ou 'help' para ver os comandos disponíveis. Clique aqui para digitar.</div>
            </div>
            <div class="terminal-input-line">
              <span class="prompt" id="term-prompt" data-i18n="about.terminalPromptUser">visitante@theodoro:~$</span> 
              <span id="terminal-current-input"></span><div class="cursor"></div>
            </div>
            <input type="text" id="terminal-hidden-input" autocomplete="off" spellcheck="false" />
          </div>
        </div>
        
        <div class="floating-badge badge-1">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#a855f7" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          <span data-i18n="about.badge1">Segurança Nível A</span>
        </div>
        
        <div class="floating-badge badge-2">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          <span data-i18n="about.badge2">Latência Zero</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    background-color: #050505;
    padding: 10rem 0;
    position: relative;
    overflow: hidden;
  }
  
  .badge {
    display: inline-block;
    padding: 0.4rem 1rem;
    background: rgba(168, 85, 247, 0.1);
    color: #c084fc;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(168, 85, 247, 0.2);
  }
  
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }
  
  .about-content h2 {
    font-size: 3rem;
    margin-bottom: 2rem;
  }
  
  .animated-gradient {
    background: linear-gradient(to right, #ffffff, #a855f7, #ffffff);
    background-size: 200% auto;
    color: #fff;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shine 4s linear infinite;
  }
  
  .about-text p {
    color: #94a3b8;
    font-size: 1.15rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }
  
  .about-text strong {
    color: #fff;
    font-weight: 600;
  }
  
  .tech-stack {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3rem;
  }
  
  .stack-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #f8fafc;
    font-weight: 500;
    font-size: 0.95rem;
  }
  
  .stack-item svg {
    color: #10b981;
  }
  
  /* Cyber Window Styling */
  .about-visual {
    position: relative;
    perspective: 1000px;
  }
  
  .about-visual::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 120%;
    height: 120%;
    background: radial-gradient(circle, rgba(168, 85, 247, 0.15) 0%, transparent 60%);
    z-index: 0;
  }
  
  .cyber-window {
    background-color: rgba(10, 10, 15, 0.95);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    overflow: hidden;
    position: relative;
    z-index: 1;
    box-shadow: 0 30px 60px rgba(0,0,0,0.8), inset 0 0 0 1px rgba(168,85,247,0.2);
    transform: rotateY(-15deg) rotateX(5deg);
    transition: transform 0.5s ease;
  }
  
  .cyber-window:hover {
    transform: rotateY(0deg) rotateX(0deg);
  }
  
  .window-header {
    background-color: rgba(255, 255, 255, 0.05);
    padding: 12px 16px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }
  
  .dots {
    display: flex;
    gap: 8px;
  }
  
  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }
  
  .red { background-color: #ff5f56; }
  .yellow { background-color: #ffbd2e; }
  .green { background-color: #27c93f; }
  
  .terminal-title {
    margin: 0 auto;
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.85rem;
    color: #94a3b8;
  }
  
  .window-body {
    padding: 2rem;
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 0.95rem;
    line-height: 1.8;
    color: #e2e8f0;
    height: 350px;
    overflow-y: auto;
    position: relative;
    cursor: text;
  }
  
  .window-body::-webkit-scrollbar {
    width: 8px;
  }
  .window-body::-webkit-scrollbar-track {
    background: transparent;
  }
  .window-body::-webkit-scrollbar-thumb {
    background: rgba(168, 85, 247, 0.3);
    border-radius: 4px;
  }
  
  .line {
    margin-bottom: 0.2rem;
    word-break: break-all;
  }
  
  .prompt { color: #a855f7; font-weight: bold; margin-right: 8px; }
  .cmd { color: #fff; }
  .output { color: #94a3b8; }
  .output.success { color: #10b981; }
  .output.error { color: #ef4444; }
  .output.warning { color: #f59e0b; }
  
  .terminal-input-line {
    display: flex;
    align-items: center;
  }
  
  #terminal-current-input {
    color: #fff;
    white-space: pre;
  }
  
  .cursor {
    display: inline-block;
    width: 8px;
    height: 18px;
    background: #a855f7;
    animation: blink 1s step-end infinite;
    margin-left: 2px;
    vertical-align: middle;
  }
  
  #terminal-hidden-input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    width: 1px;
    height: 1px;
  }
  
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
  
  .floating-badge {
    position: absolute;
    background: rgba(10, 10, 15, 0.9);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.85rem;
    font-weight: 600;
    color: #fff;
    z-index: 2;
    box-shadow: 0 10px 20px rgba(0,0,0,0.5);
  }
  
  .badge-1 {
    top: -20px;
    right: -20px;
    animation: float 6s ease-in-out infinite;
  }
  
  .badge-2 {
    bottom: -20px;
    left: -20px;
    animation: float 8s ease-in-out infinite reverse;
  }
  
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-15px); }
  }
  
  @media (max-width: 992px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 4rem;
    }
    
    .about-content h2 {
      font-size: 2.5rem;
    }
    
    .floating-badge {
      display: none;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const terminal = document.getElementById('interactive-terminal');
    const hiddenInput = document.getElementById('terminal-hidden-input');
    const currentInputDisplay = document.getElementById('terminal-current-input');
    const outputArea = document.getElementById('terminal-output');
    const promptDisplay = document.getElementById('term-prompt');
    
    if (!terminal || !hiddenInput || !currentInputDisplay || !outputArea) return;

    let currentLang = 'pt';
    try {
      currentLang = localStorage.getItem('theodoro_lang') || 'pt';
    } catch(e) {}

    window.addEventListener('languageChange', (e) => {
      if (e.detail && e.detail.lang) {
        currentLang = e.detail.lang;
        if (promptDisplay) {
          promptDisplay.textContent = currentLang === 'pt' ? 'visitante@theodoro:~$' : (currentLang === 'es' ? 'invitado@theodoro:~$' : 'guest@theodoro:~$');
        }
      }
    });

    terminal.addEventListener('click', () => {
      hiddenInput.focus();
    });

    hiddenInput.addEventListener('input', (e) => {
      currentInputDisplay.textContent = e.target.value;
      terminal.scrollTop = terminal.scrollHeight;
    });

    hiddenInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const cmd = hiddenInput.value.trim();
        const pText = promptDisplay ? promptDisplay.textContent : 'visitante@theodoro:~$';
        
        const cmdLine = document.createElement('div');
        cmdLine.className = 'line';
        cmdLine.innerHTML = `<span class="prompt">${pText}</span> <span class="cmd">${cmd}</span>`;
        outputArea.appendChild(cmdLine);
        
        executeCommand(cmd.toLowerCase());
        
        hiddenInput.value = '';
        currentInputDisplay.textContent = '';
        terminal.scrollTop = terminal.scrollHeight;
      }
    });
    
    function printOutput(htmlContent, styleClass = '') {
      const outLine = document.createElement('div');
      outLine.className = `line output ${styleClass}`;
      outLine.innerHTML = htmlContent;
      outputArea.appendChild(outLine);
    }
    
    function executeCommand(cmd) {
      if (!cmd) return;
      
      switch(cmd) {
        case 'ajuda':
        case 'help':
        case 'ayuda':
          if (currentLang === 'en') {
            printOutput('Available commands:');
            printOutput('&nbsp;&nbsp;<b>about</b>&nbsp;&nbsp;&nbsp;&nbsp;- Discover who we are');
            printOutput('&nbsp;&nbsp;<b>stack</b>&nbsp;&nbsp;&nbsp;&nbsp;- Tech stack and tools');
            printOutput('&nbsp;&nbsp;<b>contact</b>&nbsp;&nbsp;- How to reach us');
            printOutput('&nbsp;&nbsp;<b>clear</b>&nbsp;&nbsp;&nbsp;&nbsp;- Clear the terminal');
            printOutput('&nbsp;&nbsp;<b>sudo</b>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;- [RESTRICTED ACCESS]');
          } else if (currentLang === 'es') {
            printOutput('Comandos disponibles:');
            printOutput('&nbsp;&nbsp;<b>sobre</b>&nbsp;&nbsp;&nbsp;&nbsp;- Conozca quiénes somos');
            printOutput('&nbsp;&nbsp;<b>stack</b>&nbsp;&nbsp;&nbsp;&nbsp;- Tecnologías y herramientas');
            printOutput('&nbsp;&nbsp;<b>contacto</b>&nbsp;- Cómo contactarnos');
            printOutput('&nbsp;&nbsp;<b>limpiar</b>&nbsp;&nbsp;- Limpiar la terminal');
            printOutput('&nbsp;&nbsp;<b>sudo</b>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;- [ACCESO RESTRINGIDO]');
          } else {
            printOutput('Comandos disponíveis:');
            printOutput('&nbsp;&nbsp;<b>sobre</b>&nbsp;&nbsp;&nbsp;&nbsp;- Descubra quem somos');
            printOutput('&nbsp;&nbsp;<b>stack</b>&nbsp;&nbsp;&nbsp;&nbsp;- Tecnologias utilizadas');
            printOutput('&nbsp;&nbsp;<b>contato</b>&nbsp;&nbsp;- Como falar conosco');
            printOutput('&nbsp;&nbsp;<b>limpar</b>&nbsp;&nbsp;&nbsp;- Limpa a tela do terminal');
            printOutput('&nbsp;&nbsp;<b>sudo</b>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;- [ACESSO RESTRITO]');
          }
          break;
          
        case 'sobre':
        case 'about':
          if (currentLang === 'en') {
            printOutput('Theodoro Digital is a boutique software engineering studio.', 'success');
            printOutput('We build zero-compromise technological infrastructure for businesses scaling with speed and security.');
          } else if (currentLang === 'es') {
            printOutput('Theodoro Digital es un estudio boutique de ingeniería de software.', 'success');
            printOutput('Construimos infraestructura tecnológica a medida para empresas que necesitan escalar con seguridad.');
          } else {
            printOutput('Theodoro Digital é uma operação boutique de engenharia de software.', 'success');
            printOutput('Nós não usamos templates prontos. Nós construímos infraestrutura tecnológica sob medida para empresas que precisam escalar.');
          }
          break;
          
        case 'stack':
        case 'tecnologias':
        case 'tecnologia':
          if (currentLang === 'en') {
            printOutput('High-Performance Stack:');
            printOutput('- Frontend: Astro, React, Next.js, TypeScript, TailwindCSS');
            printOutput('- Backend: Node.js, Python, Go, NestJS');
            printOutput('- Databases: PostgreSQL, MongoDB, Redis');
            printOutput('- Infrastructure: Cloudflare Edge, AWS, Docker');
          } else if (currentLang === 'es') {
            printOutput('Stack de Alto Rendimiento:');
            printOutput('- Frontend: Astro, React, Next.js, TypeScript, TailwindCSS');
            printOutput('- Backend: Node.js, Python, Go, NestJS');
            printOutput('- Bases de Datos: PostgreSQL, MongoDB, Redis');
            printOutput('- Infraestructura: Cloudflare Edge, AWS, Docker');
          } else {
            printOutput('Nossa stack de alta performance:');
            printOutput('- Frontend: Astro, React, Next.js, TypeScript, TailwindCSS');
            printOutput('- Backend: Node.js, Python, Go, NestJS');
            printOutput('- Banco de Dados: PostgreSQL, MongoDB, Redis');
            printOutput('- Infra: Cloudflare Edge, AWS, Docker');
          }
          break;
          
        case 'contato':
        case 'contact':
        case 'contacto':
          if (currentLang === 'en') {
            printOutput('Initiating communication protocol...', 'warning');
            printOutput('Direct WhatsApp: <a href="https://wa.me/5511961742713" target="_blank" style="color: #a855f7; text-decoration: underline;">+55 (11) 96174-2713 (Chat on WhatsApp)</a>');
            printOutput('Proposal Form: <a href="#orcamento" style="color: #a855f7; text-decoration: underline;">Open Request Form</a>');
            printOutput('Status: Ready for briefing.');
          } else if (currentLang === 'es') {
            printOutput('Iniciando protocolo de comunicación...', 'warning');
            printOutput('WhatsApp Directo: <a href="https://wa.me/5511961742713" target="_blank" style="color: #a855f7; text-decoration: underline;">+55 (11) 96174-2713 (Abrir en WhatsApp)</a>');
            printOutput('Formulario: <a href="#orcamento" style="color: #a855f7; text-decoration: underline;">Ir al formulario de presupuesto</a>');
            printOutput('Estado: Esperando su mensaje.');
          } else {
            printOutput('Iniciando protocolo de comunicação...', 'warning');
            printOutput('WhatsApp Direto: <a href="https://wa.me/5511961742713" target="_blank" style="color: #a855f7; text-decoration: underline;">(11) 96174-2713 (Abrir no WhatsApp)</a>');
            printOutput('Formulário: <a href="#orcamento" style="color: #a855f7; text-decoration: underline;">Ir para o formulário de orçamento</a>');
            printOutput('Status: Aguardando sua mensagem.');
          }
          break;
          
        case 'limpar':
        case 'clear':
          outputArea.innerHTML = '';
          break;
          
        case 'quemsoueu':
        case 'whoami':
        case 'quiensoy':
          if (currentLang === 'en') {
            printOutput('Guest user detected. Permission level: Standard visitor.');
          } else if (currentLang === 'es') {
            printOutput('Usuario visitante detectado. Nivel de acceso: Estándar.');
          } else {
            printOutput('Visitante detectado. Nível de acesso: Padrão.');
          }
          break;
          
        case 'sudo':
          if (currentLang === 'en') {
            printOutput('FATAL ERROR: Permission denied.', 'error');
            printOutput('This incident has been reported to the system administrator.', 'error');
          } else if (currentLang === 'es') {
            printOutput('ERROR CRÍTICO: Permiso denegado.', 'error');
            printOutput('Este incidente ha sido reportado al administrador.', 'error');
          } else {
            printOutput('ERRO CRÍTICO: Permissão negada.', 'error');
            printOutput('Este incidente foi reportado ao administrador do sistema.', 'error');
          }
          break;
          
        default:
          if (currentLang === 'en') {
            printOutput(`bash: ${cmd}: command not found`, 'error');
            printOutput(`Type 'help' to see available commands.`);
          } else if (currentLang === 'es') {
            printOutput(`bash: ${cmd}: comando no encontrado`, 'error');
            printOutput(`Escriba 'ayuda' para ver los comandos disponibles.`);
          } else {
            printOutput(`bash: ${cmd}: comando não encontrado`, 'error');
            printOutput(`Digite 'ajuda' para ver os comandos disponíveis.`);
          }
      }
    }
  });
</script>
