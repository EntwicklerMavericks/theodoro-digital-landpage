---
import { config } from '../data/config';
---

<header class="header" id="main-header">
  <div class="container header-content">
    <a href="/" class="brand-container">
      <svg class="brand-logo" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="logo-gradient" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#ffffff" />
            <stop offset="100%" stop-color="#a855f7" />
          </linearGradient>
        </defs>
        <path d="M 47 14 L 53 14 L 53 80 L 50 88 L 47 80 Z M 41 14 L 5 14 L 10 20 L 41 20 Z M 41 25 L 15 25 L 20 31 L 35 31 L 35 59 L 41 75 Z M 59 14 L 95 14 L 90 20 L 59 20 Z M 59 25 L 85 25 L 80 31 L 65 31 L 65 59 L 59 75 Z" fill="url(#logo-gradient)"/>
      </svg>
      <div class="brand-text">
        <span class="brand-name">THEODORO</span>
        <span class="brand-sub">DIGITAL</span>
      </div>
    </a>

    <nav id="main-nav" class="nav">
      <ul class="nav-list">
        <li><a href="#solucoes" class="nav-link" data-i18n="nav.solutions">Soluções</a></li>
        <li><a href="#metodologia" class="nav-link" data-i18n="nav.methodology">Metodologia</a></li>
        <li><a href="#sobre" class="nav-link" data-i18n="nav.engineering">Engenharia</a></li>
      </ul>
      <a href="#orcamento" class="btn-cyber-sm">
        <span data-i18n="nav.cta">Iniciar</span>
      </a>
    </nav>
    
    <div class="header-actions">
      <div class="lang-switcher" aria-label="Selecione o idioma">
        <button class="lang-btn active" data-lang="pt" type="button" aria-label="Português">PT</button>
        <span class="lang-divider">/</span>
        <button class="lang-btn" data-lang="en" type="button" aria-label="English">EN</button>
        <span class="lang-divider">/</span>
        <button class="lang-btn" data-lang="es" type="button" aria-label="Español">ES</button>
      </div>

      <button class="mobile-menu-toggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="main-nav">
        <div class="menu-icon">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background-color: transparent;
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    z-index: 1000;
  }
  
  .header.scrolled {
    background-color: rgba(5, 5, 5, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }
  
  .header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.25rem;
    padding-bottom: 1.25rem;
    position: relative;
  }
  
  .brand-container {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    z-index: 1002;
  }
  
  .brand-logo {
    width: 38px;
    height: 38px;
    filter: drop-shadow(0 0 10px rgba(168, 85, 247, 0.4));
  }
  
  .brand-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  
  .brand-name {
    font-family: 'Outfit', sans-serif;
    font-size: 1.25rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: 0.18em;
    line-height: 1;
    margin-bottom: 3px;
  }
  
  .brand-sub {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.65rem;
    font-weight: 600;
    color: #a855f7;
    letter-spacing: 0.35em;
    line-height: 1;
  }
  
  .nav {
    display: flex;
    align-items: center;
    gap: 3rem;
  }
  
  .nav-list {
    display: flex;
    gap: 2.5rem;
  }
  
  .nav-link {
    font-family: 'Space Grotesk', sans-serif;
    color: #94a3b8;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: color 0.3s ease;
    position: relative;
  }
  
  .nav-link:hover {
    color: #fff;
  }
  
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 0;
    width: 0%;
    height: 2px;
    background: #a855f7;
    transition: width 0.3s ease;
    box-shadow: 0 0 10px #a855f7;
  }
  
  .nav-link:hover::after {
    width: 100%;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    z-index: 1002;
  }

  /* Language Switcher */
  .lang-switcher {
    display: inline-flex;
    align-items: center;
    background: rgba(20, 20, 25, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 50px;
    padding: 4px 8px;
    backdrop-filter: blur(12px);
    transition: all 0.3s ease;
  }

  .lang-switcher:hover {
    border-color: rgba(168, 85, 247, 0.4);
    box-shadow: 0 0 15px rgba(168, 85, 247, 0.2);
  }

  .lang-btn {
    background: transparent;
    border: none;
    color: #94a3b8;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 2px 6px;
    cursor: pointer;
    border-radius: 12px;
    transition: all 0.2s ease;
  }

  .lang-btn:hover {
    color: #fff;
  }

  .lang-btn.active {
    color: #fff;
    background: rgba(168, 85, 247, 0.35);
    box-shadow: 0 0 8px rgba(168, 85, 247, 0.5);
  }

  .lang-divider {
    color: rgba(255, 255, 255, 0.2);
    font-size: 0.7rem;
    user-select: none;
  }
  
  .btn-cyber-sm {
    position: relative;
    padding: 10px 24px;
    background: transparent;
    color: #fff;
    text-transform: uppercase;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1px;
    border: 1px solid rgba(168, 85, 247, 0.4);
    cursor: pointer;
    overflow: hidden;
    transition: 0.3s;
    border-radius: 4px;
  }
  
  .btn-cyber-sm::before {
    content: '';
    position: absolute;
    top: 0; left: -100%; width: 100%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(168, 85, 247, 0.4), transparent);
    transition: 0.5s ease;
  }
  
  .btn-cyber-sm:hover::before {
    left: 100%;
  }
  
  .btn-cyber-sm:hover {
    background: rgba(168, 85, 247, 0.1);
    box-shadow: 0 0 15px rgba(168, 85, 247, 0.3);
  }
  
  .mobile-menu-toggle {
    display: none;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 8px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .mobile-menu-toggle:hover {
    border-color: #a855f7;
    background: rgba(168, 85, 247, 0.1);
  }

  .menu-icon {
    width: 20px;
    height: 14px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
  }

  .menu-icon span {
    display: block;
    width: 100%;
    height: 2px;
    background-color: #fff;
    border-radius: 2px;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-menu-toggle[aria-expanded="true"] .menu-icon span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .mobile-menu-toggle[aria-expanded="true"] .menu-icon span:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-toggle[aria-expanded="true"] .menu-icon span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  @media (max-width: 900px) {
    .mobile-menu-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .brand-logo {
      width: 32px;
      height: 32px;
    }

    .brand-name {
      font-size: 1.05rem;
    }
    
    .nav {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(3, 3, 5, 0.96);
      backdrop-filter: blur(25px);
      -webkit-backdrop-filter: blur(25px);
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 3rem 2rem;
      gap: 2.5rem;
      transform: translateY(-100%);
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
      opacity: 0;
      pointer-events: none;
      z-index: 1001;
    }
    
    .nav.is-open {
      transform: translateY(0);
      opacity: 1;
      pointer-events: all;
    }
    
    .nav-list {
      flex-direction: column;
      width: 100%;
      text-align: center;
      gap: 2rem;
    }

    .nav-link {
      font-size: 1.3rem;
      color: #fff;
    }

    .btn-cyber-sm {
      padding: 14px 32px;
      font-size: 1rem;
    }
  }

  @media (max-width: 480px) {
    .brand-text {
      display: none; /* Keep just the slim logo on very small phones so switcher fits comfortably */
    }

    .brand-logo {
      width: 30px;
      height: 30px;
    }

    .lang-switcher {
      padding: 3px 6px;
    }

    .lang-btn {
      font-size: 0.7rem;
      padding: 2px 4px;
    }
  }
</style>

<script>
  const header = document.getElementById('main-header');
  const toggle = document.querySelector('.mobile-menu-toggle');
  const nav = document.querySelector('.nav');
  
  window.addEventListener('scroll', () => {
    if (window.scrollY > 40) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }
  });
  
  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const isOpen = nav.classList.contains('is-open');
      nav.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', (!isOpen).toString());
      document.body.style.overflow = !isOpen ? 'hidden' : '';
    });

    const links = nav.querySelectorAll('a');
    links.forEach(link => {
      link.addEventListener('click', () => {
        nav.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      });
    });
  }
</script>
