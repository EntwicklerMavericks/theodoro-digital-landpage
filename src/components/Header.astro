---
import { config } from '../data/config';
---

<header class="header" id="main-header">
  <div class="container header-content">
    <a href="/" class="brand-container">
      <svg class="brand-logo" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="logo-gradient" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#ffffff" />
            <stop offset="100%" stop-color="#a855f7" />
          </linearGradient>
        </defs>
        <path d="M 47 14 L 53 14 L 53 80 L 50 88 L 47 80 Z M 41 14 L 5 14 L 10 20 L 41 20 Z M 41 25 L 15 25 L 20 31 L 35 31 L 35 59 L 41 75 Z M 59 14 L 95 14 L 90 20 L 59 20 Z M 59 25 L 85 25 L 80 31 L 65 31 L 65 59 L 59 75 Z" fill="url(#logo-gradient)"/>
      </svg>
      <div class="brand-text">
        <span class="brand-name">THEODORO</span>
        <span class="brand-sub">DIGITAL</span>
      </div>
    </a>
    
    <button class="mobile-menu-toggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="main-nav">
      <div class="menu-icon">
        <span></span><span></span>
      </div>
    </button>

    <nav id="main-nav" class="nav">
      <ul class="nav-list">
        <li><a href="#solucoes" class="nav-link">Soluções</a></li>
        <li><a href="#metodologia" class="nav-link">Metodologia</a></li>
        <li><a href="#sobre" class="nav-link">Engenharia</a></li>
      </ul>
      <a href="#orcamento" class="btn-cyber-sm">
        <span>Iniciar</span>
      </a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background-color: transparent;
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    z-index: 1000;
  }
  
  .header.scrolled {
    background-color: rgba(5, 5, 5, 0.8);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }
  
  .header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 90px;
    transition: height 0.4s ease;
  }
  
  .header.scrolled .header-content {
    height: 70px;
  }
  
  .brand-container {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }
  
  .brand-logo {
    width: 40px;
    height: 40px;
    filter: drop-shadow(0 0 10px rgba(168, 85, 247, 0.4));
    transition: transform 0.3s ease, filter 0.3s ease;
  }
  
  .brand-container:hover .brand-logo {
    transform: scale(1.05);
    filter: drop-shadow(0 0 15px rgba(168, 85, 247, 0.8));
  }
  
  .brand-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  
  .brand-name {
    font-family: 'Outfit', sans-serif;
    font-size: 1.15rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: 0.15em;
    line-height: 1;
    margin-bottom: 2px;
  }
  
  .brand-sub {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.65rem;
    font-weight: 600;
    color: #a855f7;
    letter-spacing: 0.3em;
    line-height: 1;
  }
  
  .nav {
    display: flex;
    align-items: center;
    gap: 2.5rem;
  }
  
  .nav-list {
    display: flex;
    gap: 2rem;
  }
  
  .nav-link {
    color: #94a3b8;
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: color 0.3s ease;
    position: relative;
  }
  
  .nav-link:hover {
    color: #fff;
  }
  
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 0;
    width: 0%;
    height: 2px;
    background: #a855f7;
    transition: width 0.3s ease;
    box-shadow: 0 0 10px #a855f7;
  }
  
  .nav-link:hover::after {
    width: 100%;
  }
  
  .btn-cyber-sm {
    position: relative;
    padding: 10px 24px;
    background: transparent;
    color: #fff;
    text-transform: uppercase;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1px;
    border: 1px solid rgba(168, 85, 247, 0.4);
    cursor: pointer;
    overflow: hidden;
    transition: 0.3s;
    border-radius: 4px;
  }
  
  .btn-cyber-sm::before {
    content: '';
    position: absolute;
    top: 0; left: -100%; width: 100%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(168, 85, 247, 0.4), transparent);
    transition: 0.5s ease;
  }
  
  .btn-cyber-sm:hover::before {
    left: 100%;
  }
  
  .btn-cyber-sm:hover {
    background: rgba(168, 85, 247, 0.1);
    box-shadow: 0 0 15px rgba(168, 85, 247, 0.3);
  }
  
  .mobile-menu-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
  }

  @media (max-width: 768px) {
    .mobile-menu-toggle {
      display: block;
    }
    
    .nav {
      position: absolute;
      top: 70px;
      left: 0;
      width: 100%;
      background-color: var(--color-bg-secondary);
      flex-direction: column;
      padding: 2rem;
      border-bottom: 1px solid var(--color-border);
      gap: 1.5rem;
      transform: translateY(-150%);
      transition: transform 0.3s ease-in-out;
      opacity: 0;
      pointer-events: none;
    }
    
    .nav.is-open {
      transform: translateY(0);
      opacity: 1;
      pointer-events: all;
    }
    
    .nav-list {
      flex-direction: column;
      width: 100%;
      text-align: center;
      gap: 1.5rem;
    }
  }
</style>

<script>
  const header = document.getElementById('main-header');
  const toggle = document.querySelector('.mobile-menu-toggle');
  const nav = document.querySelector('.nav');
  
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }
  });
  
  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const isOpen = nav.classList.contains('is-open');
      nav.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', (!isOpen).toString());
    });

    const links = nav.querySelectorAll('a');
    links.forEach(link => {
      link.addEventListener('click', () => {
        nav.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
