---
const offerings = [
  {
    title: "Sites e Landing Pages",
    desc: "Plataformas web ultrarrápidas, otimizadas para SEO e desenhadas cientificamente para conversão de leads e posicionamento premium.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`
  },
  {
    title: "E-commerce de Alta Performance",
    desc: "Lojas virtuais escaláveis que não travam em picos de acesso. Arquitetura focada na experiência do usuário e finalização de carrinho sem atrito.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>`
  },
  {
    title: "Sistemas Web e ERPs",
    desc: "Automação da sua operação interna. Desenvolvo painéis de controle, CRMs e ERPs sob medida para eliminar planilhas e trabalho manual.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>`
  },
  {
    title: "Aplicativos (Web e Mobile)",
    desc: "Desenvolvimento de aplicações que seus clientes ou colaboradores podem acessar de qualquer dispositivo, com a mesma fluidez de um app nativo.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>`
  },
  {
    title: "Modernização de Sistemas Legados",
    desc: "Seu sistema antigo está lento e difícil de manter? Eu refatoro a arquitetura, implemento novas features e conecto o legado com APIs modernas.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21.5 2v6h-6M2.13 15.57a9 9 0 1 0 3.1-9.61L2 8"/><path d="M9.71 14.29l-4.42 4.42"/></svg>`
  },
  {
    title: "Identidade Visual de Produto (UI/UX)",
    desc: "O design do seu software vende o seu software. Crio identidades visuais focadas em interfaces digitais premium que geram confiança imediata.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2l2.4 7.4L22 9.6l-6 4.8 2.3 7.3-6.3-4.6-6.3 4.6 2.3-7.3-6-4.8 7.6-.2z"/></svg>`
  }
];
---

<section id="solucoes" class="offerings reveal-section">
  <div class="container">
    <div class="section-header text-center">
      <div class="badge">O QUE EU FAÇO</div>
      <h2>Engenharia de Software para <span class="text-gradient">Alavancar seu Negócio</span></h2>
      <p>Esqueça os "criadores de site". Eu construo a base tecnológica que a sua empresa precisa para vender mais e operar sem gargalos.</p>
    </div>
    
    <div class="cards-grid" id="cards-grid">
      {offerings.map(item => (
        <div class="glow-card">
          <div class="card-border"></div>
          <div class="card-content">
            <div class="icon-box" set:html={item.icon} />
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .offerings {
    background-color: var(--color-bg-main);
    position: relative;
    padding: 10rem 0;
  }

  .badge {
    display: inline-block;
    padding: 0.4rem 1rem;
    background: rgba(147, 51, 234, 0.1);
    color: var(--color-lavender-neon);
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    margin-bottom: 2rem;
    border: 1px solid rgba(147, 51, 234, 0.2);
  }
  
  .section-header {
    margin-bottom: 5rem;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }
  
  .section-header h2 {
    font-size: 3rem;
  }

  .section-header p {
    color: var(--color-text-secondary);
    font-size: 1.15rem;
    margin-top: 1.5rem;
  }
  
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 1.5rem;
  }
  
  /* Complex Interactive Glow Cards */
  .glow-card {
    position: relative;
    background: #0a0a0c;
    border-radius: 16px;
    cursor: pointer;
    isolation: isolate;
  }

  /* The actual border gradient that follows mouse */
  .glow-card::before {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: 17px;
    background: radial-gradient(
      800px circle at var(--mouse-x) var(--mouse-y), 
      rgba(255, 255, 255, 0.4),
      transparent 40%
    );
    z-index: -1;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .cards-grid:hover .glow-card::before {
    opacity: 1;
  }

  /* Inner inner mask to show border */
  .card-border {
    position: absolute;
    inset: 1px;
    background: #050505; /* Main bg color */
    border-radius: 15px;
    z-index: -1;
  }

  /* Inner spotlight */
  .card-content {
    position: relative;
    height: 100%;
    padding: 3rem 2rem;
    background: radial-gradient(
      800px circle at var(--mouse-x) var(--mouse-y), 
      rgba(168, 85, 247, 0.05),
      transparent 40%
    );
    border-radius: 15px;
    display: flex;
    flex-direction: column;
    z-index: 1;
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .glow-card:hover .card-content {
    transform: translateY(-5px);
  }

  .icon-box {
    width: 50px;
    height: 50px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    margin-bottom: 1.5rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
    transition: all 0.3s ease;
  }

  .glow-card:hover .icon-box {
    background: linear-gradient(135deg, rgba(168, 85, 247, 0.2), rgba(126, 34, 206, 0.2));
    border-color: rgba(168, 85, 247, 0.4);
    color: var(--color-lavender-neon);
    transform: scale(1.1);
  }
  
  .glow-card h3 {
    font-size: 1.4rem;
    margin-bottom: 1rem;
    color: var(--color-text-main);
  }
  
  .glow-card p {
    color: var(--color-text-secondary);
    font-size: 1rem;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .section-header h2 { font-size: 2.2rem; }
    .cards-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Mouse tracking effect for cards
  const grid = document.getElementById('cards-grid');
  
  if (grid) {
    grid.onmousemove = e => {
      for (const card of document.getElementsByClassName("glow-card")) {
        const rect = (card as HTMLElement).getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        
        (card as HTMLElement).style.setProperty("--mouse-x", `${x}px`);
        (card as HTMLElement).style.setProperty("--mouse-y", `${y}px`);
      }
    };
  }
</script>
